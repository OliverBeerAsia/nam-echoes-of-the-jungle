{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nam-echoes.local/schemas/story.schema.json",
  "title": "NAM Shared Story Contract",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "generated_at",
    "quests",
    "dialogue"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quest"
      }
    },
    "dialogue": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dialogueTree"
      }
    }
  },
  "$defs": {
    "objective": {
      "type": "object",
      "required": ["id", "text", "optional"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      }
    },
    "quest": {
      "type": "object",
      "required": ["id", "title", "desc", "objectives"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "desc": { "type": "string", "minLength": 1 },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/objective" }
        }
      }
    },
    "dialogueChoice": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "go": {
          "type": ["string", "null"]
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dialogueNode": {
      "type": "object",
      "required": ["text", "choices"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/dialogueChoice" }
        }
      }
    },
    "dialogueTree": {
      "type": "object",
      "required": ["id", "name", "portrait", "nodes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "portrait": { "type": "string" },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/dialogueNode"
          }
        }
      }
    }
  }
}
