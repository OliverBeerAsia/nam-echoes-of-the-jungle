{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nam-echoes.local/schemas/crpg_release_manifest.schema.json",
  "title": "CRPG Release Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "version",
    "platform",
    "commit",
    "content_hash",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "version": { "type": "string" },
    "platform": { "type": "string" },
    "commit": { "type": "string" },
    "content_hash": { "type": "string" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string" }
        }
      }
    }
  }
}
