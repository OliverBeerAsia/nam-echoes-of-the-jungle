            },
            {
              "label": "I am taking the kit now.",
              "go": null,
              "actions": [
                "setFlag:field_kit",
                "startQuest:field_surgery",
                "completeObjective:field_surgery:obtain_field_kit",
                "resolution:violent",
                "adjustTrust:-10"
